---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleTools from '../../components/ArticleTools.astro';
import { getPosts } from '../../lib/posts';
import { categoryHref, formatDate } from '../../lib/model';
export async function getStaticPaths() { return (await getPosts()).map(post => ({ params: { slug: post.data.permalink }, props: { post } })); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth <= 3);
---
<Base title={post.data.title} description={post.data.description}>
  <div class="article-shell">
    <header class="article-header"><a class="back-link" href="/">← 全部文章</a><p class="eyebrow"><a href={categoryHref(post.data.category)}>{post.data.category}</a></p><h1>{post.data.title}</h1><div class="article-meta"><span>ChengzhiHuang</span><span aria-hidden="true">·</span><time datetime={post.data.date}>{formatDate(post.data.date)}</time>{post.data.dateBasis === 'modified' && <span>更新</span>}</div><p class="article-description">{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <a href={`/?q=${encodeURIComponent(tag)}`}>#{tag}</a>)}</div></header>
    <div class="article-grid">
      {toc.length > 0 && <aside class="toc"><details open><summary>本文目录</summary><nav aria-label="本文目录"><ol>{toc.map(h => <li class:list={{ nested: h.depth === 3 }}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav></details></aside>}
      <article class="prose"><Content /></article>
    </div>
    <div class="article-end"><span>— 本文结束 —</span><a href="/">继续阅读其他文章 →</a></div>
  </div>
  <ArticleTools />
</Base>
