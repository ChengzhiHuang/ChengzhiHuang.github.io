---
import { categories, categoryHref, formatDate } from '../lib/model';
import type { getIndex } from '../lib/posts';
interface Props { posts: Awaited<ReturnType<typeof getIndex>>; selected?: string; heading?: 'h1' | 'h2'; }
const { posts, selected = '', heading: Heading = 'h2' } = Astro.props;
const filterBase = selected ? categoryHref(selected) : '/';
---
<section class="archive" aria-label="文章归档" data-archive data-category={selected}>
  <div class="archive-toolbar">
    <Heading>{selected || '全部文章'} <span class="count" data-count>{posts.length}</span></Heading>
    <label class="search">
      <span aria-hidden="true">⌕</span>
      <span class="sr-only">搜索标题、摘要、章节或标签</span>
      <input type="search" placeholder="搜索标题、章节、标签…" aria-label="搜索标题或标签" autocomplete="off" data-search />
      <kbd class="search-kbd" aria-hidden="true" data-search-kbd>/</kbd>
    </label>
  </div>
  <nav class="categories" aria-label="文章分类">
    <a href="/" aria-current={!selected ? 'page' : undefined}>全部</a>
    {categories.map(category => <a href={categoryHref(category)} aria-current={selected === category ? 'page' : undefined}>{category}</a>)}
  </nav>
  <p class="sr-only" aria-live="polite" data-search-status></p>
  <ol class="post-list">
    {posts.map(post => (
      <li
        data-post
        data-title={post.title}
        data-description={post.description}
        data-tags={JSON.stringify(post.tags)}
        data-headings={JSON.stringify(post.headings)}
        data-category={post.category}
      >
        <div class="post-date-col">
          <time datetime={post.date}>{formatDate(post.date)}</time>
          <span class="post-reading">约 {post.readingMinutes} 分钟</span>
        </div>
        <div class="post-summary">
          <a class="post-title" href={post.href}>{post.title}<span class="post-arrow" aria-hidden="true">↗</span></a>
          <p>{post.description}</p>
          <div class="post-meta">
            <a href={categoryHref(post.category)}>{post.category}</a>
            <span aria-hidden="true">/</span>
            <span class="post-tags">
              {post.tags.map(tag => <a class="post-tag-link" href={`${filterBase}?q=${encodeURIComponent(tag)}`} data-tag={tag}>#{tag}</a>)}
            </span>
          </div>
        </div>
      </li>
    ))}
  </ol>
  <p class="empty-state" data-empty hidden={posts.length > 0}>没有找到相关文章。试试其他标题、关键词或标签。</p>
</section>
<script src="../scripts/search.ts"></script>
